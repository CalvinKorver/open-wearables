# Open Wearables Coach configuration
# Copy this file to coach/config/.env and fill in your values.

# UUID used in wearable-data MCP calls. The remote MCP service, not the coach,
# owns the Open Wearables API URL and key.
OW_USER_ID=00000000-0000-0000-0000-000000000000

# --- Anthropic Managed Agents ---

ANTHROPIC_API_KEY=sk-ant-your-key-here
MANAGED_AGENT_ID=agent_your_agent_id
MANAGED_ENVIRONMENT_ID=env_your_environment_id
# Comma-separated when the agent needs more than one vault.
MANAGED_VAULT_IDS=vault_your_mcp_vault_id
# Use a dedicated store for this Telegram user.
MANAGED_MEMORY_STORE_ID=memstore_your_memory_store_id
# Optional for testing against a proxy. Defaults to https://api.anthropic.com.
# ANTHROPIC_API_URL=https://api.anthropic.com
# Maximum seconds to wait for one agent turn.
MANAGED_AGENT_TIMEOUT_SECONDS=300

# --- Telegram ---

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Chat ID for the recipient. Find via:
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
# after sending the bot any message.
# Only this chat is answered; other senders are ignored.
TELEGRAM_CHAT_ID=123456789

# --- Scheduling ---

BRIEFING_TIMEZONE=America/Los_Angeles
BRIEFING_TIME=11:00

# Use the same timezone in the remote MCP service so local fields match this user.

# --- Storage ---

# SQLite stores only Telegram offsets, briefing idempotency, and the active
# Managed Agents session ID. Chat and durable memory remain in Anthropic.
COACH_DB_PATH=./coach.db

# --- Logging ---

LOG_LEVEL=INFO
